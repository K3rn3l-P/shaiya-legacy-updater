<Window x:Class="Shaiya_Duff_Updater.MainWindow"
        xmlns:Shaiya_Duff_Updater="clr-namespace:Shaiya_Duff_Updater"
        xmlns:LoadingAnimation="clr-namespace:Shaiya_Duff_Updater.LoadingAnimation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Closing="Window_Closing" Title="Shaiya Duff Updater" Width="960" Height="600"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        Icon="Resources/icon.ico">
  <FrameworkElement.Resources>
    <Style x:Key="TextBoxStyle" TargetType="{x:Type Control}">
      <Setter Property="UIElement.SnapsToDevicePixels" Value="true"/>
      <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="true"/>
      <Setter Property="Control.Background" Value="#99121216"/>
      <Setter Property="Control.BorderBrush" Value="#4DE8C881"/>
      <Setter Property="Control.BorderThickness" Value="1"/>
      <Setter Property="Control.Foreground" Value="#E8C881"/>
      <Setter Property="Control.FontSize" Value="12"/>
      <Setter Property="Control.FontFamily" Value="pack://application:,,,/resources/fonts/#Inter"/>
      <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="UIElement.AllowDrop" Value="true"/>
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Control}">
            <Border Name="Border" CornerRadius="4" Padding="6,2"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Settings panel — thin gold scrollbar matching website -->
    <ControlTemplate x:Key="SetScrollThumb" TargetType="{x:Type Thumb}">
      <Border x:Name="Bd" CornerRadius="3" Background="#7FE8C881" Margin="1,0"/>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="true">
          <Setter TargetName="Bd" Property="Background" Value="#E8C881"/>
        </Trigger>
        <Trigger Property="IsDragging" Value="true">
          <Setter TargetName="Bd" Property="Background" Value="#E8C881"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="SetScrollBtn" TargetType="{x:Type RepeatButton}">
      <Border Background="Transparent" Height="0"/>
    </ControlTemplate>
    <Style x:Key="SetScrollBar" TargetType="{x:Type ScrollBar}">
      <Setter Property="OverridesDefaultStyle" Value="true"/>
      <Setter Property="Width" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Border CornerRadius="3" Background="#0D070709">
              <Track x:Name="PART_Track" IsDirectionReversed="true" Margin="0,2">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand"
                                Template="{StaticResource SetScrollBtn}" Focusable="false"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Template="{StaticResource SetScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand"
                                Template="{StaticResource SetScrollBtn}" Focusable="false"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SetScrollViewer" TargetType="{x:Type ScrollViewer}">
      <Setter Property="OverridesDefaultStyle" Value="true"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollViewer}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ScrollContentPresenter Grid.Column="0"/>
              <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1"
                         Orientation="Vertical"
                         Value="{TemplateBinding VerticalOffset}"
                         Maximum="{TemplateBinding ScrollableHeight}"
                         ViewportSize="{TemplateBinding ViewportHeight}"
                         Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                         Style="{StaticResource SetScrollBar}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="UIElement.SnapsToDevicePixels" Value="true"/>
      <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="true"/>
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type CheckBox}">
            <BulletDecorator Background="Transparent">
              <BulletDecorator.Bullet>
                <Border x:Name="Border" Width="14" Height="14" CornerRadius="2" Background="Transparent"
                        BorderThickness="1" BorderBrush="#4DE8C881">
                  <Path x:Name="CheckMark" SnapsToDevicePixels="false" Stroke="#E8C881" StrokeThickness="2"
                        Data="M 0,0 L 10,10 M 0,10 L 10,0" Width="10" Height="10"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </BulletDecorator.Bullet>
              <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                RecognizesAccessKey="true"/>
            </BulletDecorator>
            <ControlTemplate.Triggers>
              <Trigger Property="ToggleButton.IsChecked" Value="false">
                <Setter TargetName="CheckMark" Property="UIElement.Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Value="{x:Null}" Property="ToggleButton.IsChecked">
                <Setter TargetName="CheckMark" Property="Path.Data" Value="M 0,7 L 7,0"/>
              </Trigger>
              <Trigger Property="UIElement.IsMouseOver" Value="true">
                <Setter TargetName="Border" Property="Border.BorderBrush" Value="#E8C881"/>
              </Trigger>
              <Trigger Property="ButtonBase.IsPressed" Value="true">
                <Setter TargetName="Border" Property="Border.Background" Value="#1AE8C881"/>
              </Trigger>
              <Trigger Property="UIElement.IsEnabled" Value="false">
                <Setter TargetName="Border" Property="Border.BorderBrush" Value="#2DE8C881"/>
                <Setter Property="Control.Foreground" Value="#2DE8C881"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </FrameworkElement.Resources>

  <Grid>
    <!-- Layer 0: background image blurred -->
    <Image Source="Resources/background.png" Stretch="UniformToFill">
      <Image.Effect>
        <BlurEffect Radius="15" KernelType="Gaussian"/>
      </Image.Effect>
    </Image>
    <!-- Layer 1: dark overlay -->
    <Rectangle Fill="#CC070709"/>

    <!-- Layer 2: drag area (transparent, covers whole window) -->
    <Rectangle MouseLeftButtonDown="DragWindow" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               Fill="Transparent"/>

    <!-- Header -->
    <Grid Height="73" VerticalAlignment="Top">
      <!-- Header background -->
      <Border Background="#CC070709" BorderBrush="#4DE8C881" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="DragWindow"/>

      <!-- Nav items -->
      <Shaiya_Duff_Updater:iMenuItem x:Name="LinkWebsite" HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="30,0,0,0" Text="Website" Link="http://shaiyaDuff.com/"/>
      <Shaiya_Duff_Updater:iMenuItem x:Name="LinkRepair" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Margin="150,0,0,0" Text="Repair" IsSelected="false" Link="Updater:Repair"/>
      <Shaiya_Duff_Updater:iMenuItem x:Name="LinkLogIn" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Margin="0,0,250,0" Text="Log In" IsSelected="true" Link="Updater:LogIn"
                                     MaxWidth="150"/>
      <Shaiya_Duff_Updater:iMenuItem x:Name="LinkRegister" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Margin="0,0,160,0" Text="Sign Up" Link="http://shaiyaDuff.com/Account/SignUp"/>

      <!-- Minimize button hit area -->
      <Rectangle Name="ButtonMinimize" Width="48" Height="73" HorizontalAlignment="Right" Margin="0,0,68,0"
                 Fill="Transparent" Cursor="Hand"
                 MouseEnter="ButtonMinimize_MouseEnter" MouseLeave="ButtonMinimize_MouseLeave"
                 MouseLeftButtonDown="ButtonMinimize_MouseLeftButtonDown"
                 MouseLeftButtonUp="ButtonMinimize_MouseLeftButtonUp"/>
      <!-- Minimize icon -->
      <TextBlock Text="─" Foreground="#E8C881" FontSize="13" IsHitTestVisible="False"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,84,0" Panel.ZIndex="1"/>

      <!-- Close button hit area -->
      <Rectangle Name="ButtonClose" Width="48" Height="73" HorizontalAlignment="Right" Margin="0,0,20,0"
                 Fill="Transparent" Cursor="Hand"
                 MouseEnter="ButtonClose_MouseEnter" MouseLeave="ButtonClose_MouseLeave"
                 MouseLeftButtonDown="ButtonClose_MouseLeftButtonDown"
                 MouseLeftButtonUp="ButtonClose_MouseLeftButtonUp"/>
      <!-- Close icon -->
      <TextBlock Text="✕" Foreground="#E8C881" FontSize="13" IsHitTestVisible="False"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,36,0" Panel.ZIndex="1"/>

      <!-- Settings icon -->
      <TextBlock x:Name="BtnOpenSettings" Text="⚙"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="15" Foreground="#7BE8C881" Cursor="Hand"
                 MouseEnter="BtnOpenSettings_MouseEnter"
                 MouseLeave="BtnOpenSettings_MouseLeave"
                 MouseLeftButtonUp="BtnOpenSettings_Click"
                 ToolTip="Settings"/>
    </Grid>

    <!-- Sliding content panel -->
    <Grid Name="GridSlide" HorizontalAlignment="Left" VerticalAlignment="Top" Width="1920"
          Margin="-960,100,0,0" RenderTransformOrigin="0,0">
      <UIElement.RenderTransform>
        <TranslateTransform/>
      </UIElement.RenderTransform>

      <!-- Latest News panel -->
      <Grid Name="GridLatestNews" HorizontalAlignment="Left" Width="960" Height="400">
        <Grid.RowDefinitions>
          <RowDefinition Height="38"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab bar -->
        <Border Grid.Row="0" Background="#CC070709" BorderBrush="#2DE8C881" BorderThickness="0,0,0,1">
          <Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border x:Name="TabBtnNews" CornerRadius="4" Margin="5,0" Padding="20,5"
                      Background="#2DE8C881" BorderBrush="#4DE8C881" BorderThickness="1"
                      Cursor="Hand" Tag="News" MouseLeftButtonUp="TabBtn_Click">
                <TextBlock x:Name="TabTxtNews" Text="News" Foreground="#E8C881"
                           FontFamily="pack://application:,,,/resources/fonts/#Cinzel"
                           FontSize="11" FontWeight="SemiBold"/>
              </Border>
              <Border x:Name="TabBtnRanking" CornerRadius="4" Margin="5,0" Padding="20,5"
                      Background="Transparent" BorderBrush="#1AE8C881" BorderThickness="1"
                      Cursor="Hand" Tag="Ranking" MouseLeftButtonUp="TabBtn_Click">
                <TextBlock x:Name="TabTxtRanking" Text="Rankings" Foreground="#7BE8C881"
                           FontFamily="pack://application:,,,/resources/fonts/#Cinzel" FontSize="11"/>
              </Border>
              <Border x:Name="TabBtnBosses" CornerRadius="4" Margin="5,0" Padding="20,5"
                      Background="Transparent" BorderBrush="#1AE8C881" BorderThickness="1"
                      Cursor="Hand" Tag="Bosses" MouseLeftButtonUp="TabBtn_Click">
                <TextBlock x:Name="TabTxtBosses" Text="Bosses" Foreground="#7BE8C881"
                           FontFamily="pack://application:,,,/resources/fonts/#Cinzel" FontSize="11"/>
              </Border>
            </StackPanel>
            <!-- Refresh icon -->
            <TextBlock x:Name="BtnRefreshTab" Text="↺"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,14,0" FontSize="18" Cursor="Hand"
                       Foreground="#4DE8C881"
                       MouseEnter="BtnRefreshTab_MouseEnter"
                       MouseLeave="BtnRefreshTab_MouseLeave"
                       MouseLeftButtonUp="BtnRefreshTab_Click"
                       ToolTip="Reload"/>
          </Grid>
        </Border>

        <!-- Content panels -->
        <Grid Grid.Row="1">
          <!-- News -->
          <ScrollViewer x:Name="NewsScrollViewer"
                        VerticalScrollBarVisibility="Hidden"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="60,8" Visibility="Visible">
            <StackPanel x:Name="NewsPanel">
              <TextBlock HorizontalAlignment="Center" Text="Loading..."
                         Foreground="#9BE0E0E0"
                         FontFamily="pack://application:,,,/resources/fonts/#Inter"
                         FontSize="13" Margin="0,20,0,0"/>
            </StackPanel>
          </ScrollViewer>

          <!-- Rankings -->
          <ScrollViewer x:Name="RankingScrollViewer" Visibility="Collapsed"
                        VerticalScrollBarVisibility="Hidden"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RankingRows" Margin="40,8,40,8"/>
          </ScrollViewer>

          <!-- Bosses -->
          <ScrollViewer x:Name="BossesScrollViewer" Visibility="Collapsed"
                        VerticalScrollBarVisibility="Hidden"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="40,8">
            <StackPanel x:Name="BossesPanel"/>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- Log In panel -->
      <Grid Name="GridLogIn" HorizontalAlignment="Right" Margin="0,0,0,0" Width="960" Height="400">

        <!-- Saved accounts list -->
        <Grid Name="GridSavedAccounts" HorizontalAlignment="Center" VerticalAlignment="Center"
              Width="290" Margin="0,0,20,0" Visibility="Hidden">
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
            <StackPanel Name="AccountRectangles" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </ScrollViewer>
        </Grid>

        <!-- New account / login form -->
        <Grid KeyDown="GridNewAccount_KeyDown" Name="GridNewAccount" HorizontalAlignment="Center"
              VerticalAlignment="Center" Width="250" Height="300" Margin="0,0,20,0" Visibility="Visible">

          <!-- Glassmorphism panel background -->
          <Border CornerRadius="8" Background="#99121216" BorderBrush="#4DE8C881" BorderThickness="1">
            <Border.Effect>
              <DropShadowEffect Color="#E8C881" BlurRadius="25" ShadowDepth="0" Opacity="0.2"/>
            </Border.Effect>
          </Border>

          <!-- Title -->
          <TextBlock Text="LOG IN" HorizontalAlignment="Center" VerticalAlignment="Top"
                     Margin="0,18,0,0" Foreground="#E8C881"
                     FontFamily="pack://application:,,,/resources/fonts/#Cinzel"
                     FontSize="18" FontWeight="Bold"/>

          <!-- Separator -->
          <Rectangle Height="1" VerticalAlignment="Top" Margin="20,50,20,0" Fill="#4DE8C881"/>

          <!-- Username label -->
          <TextBlock Text="Username" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="44,67,0,0" Foreground="#9BE0E0E0"
                     FontFamily="pack://application:,,,/resources/fonts/#Inter"
                     FontSize="9"/>

          <!-- Username TextBox -->
          <TextBox Name="TextBoxUserID" Style="{StaticResource TextBoxStyle}" CaretBrush="#E8C881"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Width="164" Height="24"
                   Margin="0,84,0,0" MaxLength="18" TextAlignment="Center"/>

          <!-- Password label -->
          <TextBlock Text="Password" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="44,125,0,0" Foreground="#9BE0E0E0"
                     FontFamily="pack://application:,,,/resources/fonts/#Inter"
                     FontSize="9"/>

          <!-- Password box -->
          <PasswordBox Name="TextBoxPassword" Style="{StaticResource TextBoxStyle}" CaretBrush="#E8C881"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Width="164" Height="24"
                       Margin="0,142,0,0" MaxLength="20" HorizontalContentAlignment="Center"/>

          <!-- Remember checkbox -->
          <CheckBox Name="CheckBoxSaveAccount" BorderBrush="Transparent" Background="Transparent"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Width="15" Height="15"
                    Margin="42,180,0,0" IsChecked="True"/>

          <!-- Remember me label -->
          <TextBlock Text="Remember me" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="62,181,0,0" Foreground="#9BE0E0E0"
                     FontFamily="pack://application:,,,/resources/fonts/#Inter"
                     FontSize="11"/>

          <!-- Login button -->
          <Shaiya_Duff_Updater:iButton x:Name="LogInButton" MouseLeftButtonUp="LogInButton_MouseLeftButtonUp"
                                       HorizontalAlignment="Center" VerticalAlignment="Top"
                                       Margin="0,210,0,0" Text="LOG IN" IsTabStop="true"/>

          <!-- Back to accounts link (hidden by default, shown only when accounts exist) -->
          <Shaiya_Duff_Updater:iMenuItem x:Name="LinkSavedAccounts" Text="Back to my accounts"
                                         Link="Updater:LogInSavedAccounts" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" FontSize="18" Margin="0,220,0,0"
                                         Visibility="Hidden"/>
        </Grid>

        <!-- Loading animation -->
        <LoadingAnimation:LoadingAnimation x:Name="LoadAnimation" Margin="0,0,15,0" Visibility="Hidden"/>
      </Grid>
    </Grid>

    <!-- Status text -->
    <TextBlock Name="TextBlockUpdaterStatus" HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Margin="40,0,0,105" Foreground="#E8C881"
               FontFamily="pack://application:,,,/resources/fonts/#Inter"
               FontSize="14"/>

    <!-- Progress bar -->
    <Shaiya_Duff_Updater:ProgressBar x:Name="UpdaterProgressBar" HorizontalAlignment="Center"
                                     VerticalAlignment="Bottom" Margin="30" Visibility="Hidden"/>

    <!-- Start Game button -->
    <Shaiya_Duff_Updater:iButton2 x:Name="GameStartButton" MouseLeftButtonUp="GameStartButton_Click"
                                  HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                  Margin="30" Text="Start Game" Visibility="Hidden"/>

    <!-- Settings overlay panel -->
    <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Panel.ZIndex="60">
      <Border Background="#DD070709"/>
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="660"
              Background="#EE121216" BorderBrush="#4DE8C881" BorderThickness="1" CornerRadius="10">
        <Border.Effect>
          <DropShadowEffect Color="#E8C881" BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Title row -->
          <Grid Grid.Row="0" Margin="24,20,24,14">
            <TextBlock Text="GAME SETTINGS"
                       FontFamily="pack://application:,,,/resources/fonts/#Cinzel"
                       FontSize="15" FontWeight="SemiBold" Foreground="#E8C881"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="BtnSettingsClose" Text="✕"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="14" Foreground="#7BE8C881" Cursor="Hand"
                       MouseEnter="BtnSettingsClose_MouseEnter"
                       MouseLeave="BtnSettingsClose_MouseLeave"
                       MouseLeftButtonUp="BtnSettingsOverlay_Close"/>
          </Grid>
          <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                     Margin="24,0,24,0" Fill="#2DE8C881"/>

          <!-- Tab bar -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,14,24,0">
            <Border x:Name="SetTabVideo" CornerRadius="4" Margin="0,0,6,0" Padding="18,5"
                    Background="#2DE8C881" BorderBrush="#4DE8C881" BorderThickness="1"
                    Cursor="Hand" Tag="Video" MouseLeftButtonUp="SetTab_Click">
              <TextBlock x:Name="SetTabVideoTxt" Text="Video" Foreground="#E8C881"
                         FontFamily="pack://application:,,,/resources/fonts/#Cinzel"
                         FontSize="10" FontWeight="SemiBold"/>
            </Border>
            <Border x:Name="SetTabInterface" CornerRadius="4" Margin="0,0,6,0" Padding="18,5"
                    Background="Transparent" BorderBrush="#1AE8C881" BorderThickness="1"
                    Cursor="Hand" Tag="Interface" MouseLeftButtonUp="SetTab_Click">
              <TextBlock x:Name="SetTabInterfaceTxt" Text="Interface" Foreground="#7BE8C881"
                         FontFamily="pack://application:,,,/resources/fonts/#Cinzel" FontSize="10"/>
            </Border>
            <Border x:Name="SetTabSound" CornerRadius="4" Margin="0,0,6,0" Padding="18,5"
                    Background="Transparent" BorderBrush="#1AE8C881" BorderThickness="1"
                    Cursor="Hand" Tag="Sound" MouseLeftButtonUp="SetTab_Click">
              <TextBlock x:Name="SetTabSoundTxt" Text="Sound" Foreground="#7BE8C881"
                         FontFamily="pack://application:,,,/resources/fonts/#Cinzel" FontSize="10"/>
            </Border>
            <Border x:Name="SetTabAdvanced" CornerRadius="4" Padding="18,5"
                    Background="Transparent" BorderBrush="#1AE8C881" BorderThickness="1"
                    Cursor="Hand" Tag="Advanced" MouseLeftButtonUp="SetTab_Click">
              <TextBlock x:Name="SetTabAdvancedTxt" Text="Advanced" Foreground="#7BE8C881"
                         FontFamily="pack://application:,,,/resources/fonts/#Cinzel" FontSize="10"/>
            </Border>
          </StackPanel>

          <!-- Scrollable content -->
          <Grid Grid.Row="2" Margin="24,10,24,0">
            <ScrollViewer x:Name="SetScrollVideo" Style="{StaticResource SetScrollViewer}"
                          VerticalScrollBarVisibility="Auto" Visibility="Visible">
              <StackPanel x:Name="SetPanelVideo" Margin="0,0,8,0"/>
            </ScrollViewer>
            <ScrollViewer x:Name="SetScrollSound" Style="{StaticResource SetScrollViewer}"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel x:Name="SetPanelSound" Margin="0,0,8,0"/>
            </ScrollViewer>
            <ScrollViewer x:Name="SetScrollAdvanced" Style="{StaticResource SetScrollViewer}"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel x:Name="SetPanelAdvanced" Margin="0,0,8,0"/>
            </ScrollViewer>
            <ScrollViewer x:Name="SetScrollInterface" Style="{StaticResource SetScrollViewer}"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel x:Name="SetPanelInterface" Margin="0,0,8,0"/>
            </ScrollViewer>
          </Grid>
          <Rectangle Grid.Row="2" Height="1" VerticalAlignment="Bottom"
                     Margin="24,0,24,0" Fill="#2DE8C881"/>

          <!-- Save / Cancel -->
          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                      Margin="24,14,24,20">
            <Border CornerRadius="4" Padding="24,7" Margin="0,0,8,0"
                    Background="Transparent" BorderBrush="#1AE8C881" BorderThickness="1"
                    Cursor="Hand" MouseLeftButtonUp="BtnSettingsOverlay_Close">
              <TextBlock Text="Cancel" Foreground="#7BE8C881"
                         FontFamily="pack://application:,,,/resources/fonts/#Inter" FontSize="11"/>
            </Border>
            <Border x:Name="BtnSettingsSave" CornerRadius="4" Padding="24,7"
                    Background="#1AE8C881" BorderBrush="#4DE8C881" BorderThickness="1"
                    Cursor="Hand"
                    MouseEnter="BtnSettingsSave_MouseEnter"
                    MouseLeave="BtnSettingsSave_MouseLeave"
                    MouseLeftButtonUp="BtnSettingsSave_Click">
              <TextBlock Text="Save" Foreground="#E8C881"
                         FontFamily="pack://application:,,,/resources/fonts/#Inter"
                         FontSize="11" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Game launch overlay panel -->
    <Grid x:Name="GameLaunchPanel" Visibility="Collapsed" Panel.ZIndex="50">
      <Border Background="#DD070709"/>
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="560" MinHeight="190"
              Background="#EE121216" BorderBrush="#4DE8C881" BorderThickness="1" CornerRadius="10"
              Padding="30,24,30,24">
        <Border.Effect>
          <DropShadowEffect Color="#E8C881" BlurRadius="30" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>
        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <TextBlock x:Name="GameLaunchTitle" Text="Connecting to the server..."
                     TextAlignment="Center"
                     FontFamily="pack://application:,,,/resources/fonts/#Cinzel"
                     Foreground="#E8C881" FontSize="28" FontWeight="SemiBold"
                     TextWrapping="Wrap" Margin="0,0,0,8"/>
          <TextBlock x:Name="GameLaunchSubText" Text="Preparing character selection. Please wait."
                     TextAlignment="Center" Foreground="#E0E0E0"
                     FontFamily="pack://application:,,,/resources/fonts/#Inter"
                     FontSize="15" TextWrapping="Wrap" Margin="0,0,0,22"/>
          <ProgressBar IsIndeterminate="True" Height="6" Minimum="0" Maximum="100"
                       Foreground="#E8C881" Background="#CC070709" BorderBrush="#4DE8C881"
                       BorderThickness="1"/>
          <TextBlock Text="The game window will appear when character selection is ready."
                     TextAlignment="Center" Foreground="#99E0E0E0"
                     FontFamily="pack://application:,,,/resources/fonts/#Inter"
                     FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
