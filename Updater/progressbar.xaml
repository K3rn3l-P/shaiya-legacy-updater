<UserControl x:Class="Shaiya_Duff_Updater.ProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="900" Height="68">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="22"/>
      <RowDefinition Height="14"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Status + Speed -->
    <Grid Grid.Row="0" VerticalAlignment="Center">
      <TextBlock x:Name="TxtStatus"
                 FontFamily="pack://application:,,,/resources/fonts/#Cinzel"
                 FontSize="11" FontWeight="SemiBold" Foreground="#E8C881"
                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="TxtSpeed"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 FontFamily="pack://application:,,,/resources/fonts/#Inter"
                 FontSize="11" Foreground="#9BE0E0E0"/>
    </Grid>

    <!-- Bar -->
    <Border Grid.Row="1" CornerRadius="7" Background="#CC070709" BorderBrush="#2DE8C881" BorderThickness="1">
      <Canvas x:Name="BarCanvas" Margin="1" ClipToBounds="True">
        <Rectangle x:Name="ProgressFill" Canvas.Left="0" Canvas.Top="0" Height="10" Width="0" RadiusX="6" RadiusY="6"/>
      </Canvas>
    </Border>

    <!-- Bytes + Percent -->
    <Grid Grid.Row="2" VerticalAlignment="Top" Margin="0,4,0,0">
      <TextBlock x:Name="TxtBytes"
                 FontFamily="pack://application:,,,/resources/fonts/#Inter"
                 FontSize="10" Foreground="#7BE0E0E0"/>
      <TextBlock x:Name="TxtPercent"
                 HorizontalAlignment="Right"
                 FontFamily="pack://application:,,,/resources/fonts/#Inter"
                 FontSize="10" Foreground="#7BE8C881"/>
    </Grid>
  </Grid>
</UserControl>
