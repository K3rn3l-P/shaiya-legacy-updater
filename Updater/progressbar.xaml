<UserControl x:Class="Shaiya_Duff_Updater.ProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             Width="900" Height="40">
  <Grid>
    <Border CornerRadius="4" Background="#CC070709" BorderBrush="#4DE8C881" BorderThickness="1"/>
    <Canvas Margin="3.5,3.5,3.5,3.5" ClipToBounds="True">
      <Rectangle x:Name="ProgressImage" Canvas.Left="0" Canvas.Top="0" Height="33" Width="0"
                 RadiusX="2" RadiusY="2">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E8C881" Offset="0"/>
            <GradientStop Color="#FFF3C9" Offset="0.5"/>
            <GradientStop Color="#E8C881" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
    </Canvas>
  </Grid>
</UserControl>
