<Window x:Class="Shaiya_Duff_Updater.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shaiya Duff" Width="640" Height="120" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Icon="Resources/icon.ico">
  <Border Background="#F0070709" BorderBrush="#4DE8C881" BorderThickness="1" CornerRadius="8">
    <Border.Effect>
      <DropShadowEffect Color="#E8C881" BlurRadius="30" ShadowDepth="0" Opacity="0.25"/>
    </Border.Effect>
    <Grid>
      <Image Source="Resources/logo.png"/>
    </Grid>
  </Border>
</Window>
