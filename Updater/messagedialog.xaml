<Window x:Class="Shaiya_Duff_Updater.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720" Height="224" WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="NoResize" Icon="Resources/icon.ico"
        AllowsTransparency="True" Background="Transparent">
  <Border Background="#F0070709" BorderBrush="#4DE8C881" BorderThickness="1" CornerRadius="8">
    <Border.Effect>
      <DropShadowEffect Color="#E8C881" BlurRadius="30" ShadowDepth="0" Opacity="0.25"/>
    </Border.Effect>
    <Grid>
      <Rectangle MouseLeftButtonDown="DragWindow" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                 Fill="Transparent"/>
      <Grid Name="TitleGrid" HorizontalAlignment="Stretch" VerticalAlignment="Top" Width="720" Height="68">
        <TextBlock MouseLeftButtonDown="DragWindow" Name="TextBlockTitle" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="#E8C881"
                   FontFamily="pack://application:,,,/resources/fonts/#Cinzel"
                   FontSize="22" FontWeight="SemiBold"/>
      </Grid>
      <Grid Name="TextGrid" HorizontalAlignment="Stretch" VerticalAlignment="Top" Width="720" Height="86"
            Margin="0,68,0,0">
        <TextBlock MouseLeftButtonDown="DragWindow" Name="TextBlockText" TextWrapping="Wrap" MaxWidth="680"
                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#E0E0E0"
                   FontFamily="pack://application:,,,/resources/fonts/#Inter"
                   FontSize="16"/>
      </Grid>
      <Grid Name="ButtonsGrid" HorizontalAlignment="Stretch" VerticalAlignment="Top" Width="720" Height="70"
            Margin="0,154,0,0">
        <WrapPanel Name="ButtonContainer" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FlowDirection="LeftToRight"/>
      </Grid>
    </Grid>
  </Border>
</Window>
