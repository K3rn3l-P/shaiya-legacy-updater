<UserControl x:Class="Shaiya_Duff_Updater.iButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             MouseEnter="UserControl_MouseEnter" MouseLeave="UserControl_MouseLeave"
             MouseLeftButtonDown="UserControl_MouseLeftButtonDown"
             MouseLeftButtonUp="UserControl_MouseLeftButtonUp"
             Width="100" Height="30" Cursor="Hand" Background="Transparent">
  <Border x:Name="ButtonBorder" CornerRadius="4"
          Background="#1AE8C881" BorderBrush="#4DE8C881" BorderThickness="1">
    <TextBlock x:Name="TextBlockButtonText" HorizontalAlignment="Center" VerticalAlignment="Center"
               Foreground="#E8C881"
               FontFamily="pack://application:,,,/resources/fonts/#Cinzel"
               FontSize="13" FontWeight="SemiBold"/>
  </Border>
</UserControl>
