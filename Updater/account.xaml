<UserControl x:Class="Shaiya_Duff_Updater.Account"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             MouseEnter="UserControl_MouseEnter" MouseLeave="UserControl_MouseLeave"
             Width="270" Height="40" Margin="0,4" Background="Transparent">
  <Grid>
    <Grid MouseEnter="GridAccountRemove_MouseEnter" MouseLeave="GridAccountRemove_MouseLeave"
          MouseLeftButtonDown="GridAccountRemove_MouseLeftButtonDown"
          MouseLeftButtonUp="GridAccountRemove_MouseLeftButtonUp" Name="GridAccountRemove"
          Visibility="Hidden" HorizontalAlignment="Left" Width="40" Cursor="Hand" Background="Transparent">
      <TextBlock x:Name="TextBlockX" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="#E8C881"
                 FontFamily="pack://application:,,,/resources/fonts/#Cinzel"
                 FontSize="18" Text="✕"/>
    </Grid>
    <Grid MouseEnter="GridAccountName_MouseEnter" MouseLeave="GridAccountName_MouseLeave"
          MouseLeftButtonDown="GridAccountName_MouseLeftButtonDown"
          MouseLeftButtonUp="GridAccountName_MouseLeftButtonUp" Name="GridAccountName"
          HorizontalAlignment="Center" Width="180" Cursor="Hand" Background="Transparent">
      <Border CornerRadius="4" Background="#1AE8C881" BorderBrush="#4DE8C881" BorderThickness="1"/>
      <Viewbox StretchDirection="DownOnly" Stretch="Uniform" Width="160" Margin="0,0,0,2">
        <ContentControl>
          <TextBlock x:Name="TextBlockUserID" Foreground="#E8C881"
                     FontFamily="pack://application:,,,/resources/fonts/#Cinzel"
                     FontSize="18"/>
        </ContentControl>
      </Viewbox>
    </Grid>
  </Grid>
</UserControl>
