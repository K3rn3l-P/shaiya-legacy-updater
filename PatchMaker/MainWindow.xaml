<Window x:Class="PatchMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PatchMaker — Shaiya Patch Tool"
        Width="880" Height="720" MinWidth="740" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI"
        Foreground="#E0E0E0"
        FontSize="12">

    <!-- Outer rounded border with gradient background -->
    <Border CornerRadius="8" BorderBrush="#4DE8C881" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0D0D10" Offset="0"/>
                <GradientStop Color="#070709" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#E8C881" BlurRadius="24" ShadowDepth="0" Opacity="0.13"/>
        </Border.Effect>

        <Grid Margin="12,10,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Header (draggable) ────────────────────────────── -->
            <Border Grid.Row="0" Margin="0,0,0,8" Padding="16,10"
                    CornerRadius="6" BorderThickness="1" BorderBrush="#2DE8C881"
                    Background="#0F0F14">
                <Border.Effect>
                    <DropShadowEffect Color="#E8C881" BlurRadius="18" ShadowDepth="0" Opacity="0.08"/>
                </Border.Effect>
                <Grid>
                    <!-- Left: title + subtitle + by K3rn3l (area drag) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                MouseLeftButtonDown="DragWindow">
                        <TextBlock Text="PATCHMAKER" Foreground="#E8C881"
                                   FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Rectangle Width="1" Height="14" Fill="#2DE8C881" Margin="12,0"/>
                        <TextBlock Text="{DynamicResource AppSubtitle}" Foreground="#50E8C881"
                                   FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="  ·  by K3rn3l" Foreground="#28E8C881"
                                   FontSize="10" VerticalAlignment="Center" FontStyle="Italic"/>
                    </StackPanel>

                    <!-- Right: gear + lang + min + close -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <!-- Settings gear -->
                        <Border x:Name="BtnSettings" CornerRadius="3" Padding="9,3" Cursor="Hand"
                                BorderThickness="1" Background="Transparent"
                                MouseLeftButtonUp="BtnSettings_Click"
                                MouseEnter="BtnChromeBtn_MouseEnter"
                                MouseLeave="BtnChromeBtn_MouseLeave">
                            <Border.BorderBrush><SolidColorBrush Color="#20E8C881"/></Border.BorderBrush>
                            <TextBlock Text="⚙" FontSize="13" Foreground="#60E8C881"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>

                        <TextBlock Text="  " FontSize="10" Margin="3,0"/>
                        <Rectangle Width="1" Height="14" Fill="#15E8C881" Margin="0,0,8,0"/>

                        <!-- Language toggle -->
                        <Border x:Name="BtnLangIt" CornerRadius="3" Padding="10,3" Cursor="Hand"
                                BorderThickness="1" MouseLeftButtonUp="BtnLangIt_Click">
                            <TextBlock x:Name="TbLangIt" Text="IT" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text=" │ " Foreground="#20E8C881" VerticalAlignment="Center"
                                   FontSize="10" Margin="1,0"/>
                        <Border x:Name="BtnLangEn" CornerRadius="3" Padding="10,3" Cursor="Hand"
                                BorderThickness="1" MouseLeftButtonUp="BtnLangEn_Click">
                            <TextBlock x:Name="TbLangEn" Text="EN" FontSize="10" FontWeight="Bold"/>
                        </Border>

                        <Rectangle Width="1" Height="14" Fill="#15E8C881" Margin="8,0"/>

                        <!-- Minimize -->
                        <Border x:Name="BtnMin" CornerRadius="3" Padding="10,3" Cursor="Hand"
                                Background="Transparent" BorderThickness="0"
                                MouseLeftButtonUp="BtnMin_Click"
                                MouseEnter="BtnChromeBtn_MouseEnter"
                                MouseLeave="BtnChromeBtn_MouseLeave">
                            <TextBlock Text="─" FontSize="11" Foreground="#60E8C881"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>

                        <!-- Close -->
                        <Border x:Name="BtnClose" CornerRadius="3" Padding="10,3" Cursor="Hand"
                                Background="Transparent" BorderThickness="0"
                                MouseLeftButtonUp="BtnClose_Click"
                                MouseEnter="BtnCloseChromeBtn_MouseEnter"
                                MouseLeave="BtnChromeBtn_MouseLeave">
                            <TextBlock Text="✕" FontSize="11" Foreground="#60E8C881"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── SSH ──────────────────────────────────────────── -->
            <GroupBox Grid.Row="1" Header="{DynamicResource GbSsh}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label  Grid.Column="0" Content="{DynamicResource LblHost}"/>
                    <TextBox Grid.Column="1" x:Name="TbSshHost"/>
                    <Label  Grid.Column="2" Content="{DynamicResource LblUser}"/>
                    <TextBox Grid.Column="3" x:Name="TbSshUser"/>
                    <Label  Grid.Column="4" Content="{DynamicResource LblPass}"/>
                    <PasswordBox Grid.Column="5" x:Name="PbSshPass"/>
                    <TextBlock Grid.Column="6" x:Name="TbConnStatus"
                               VerticalAlignment="Center" Margin="12,0"
                               Foreground="#BB4444" FontSize="11" FontWeight="SemiBold"/>
                    <Button Grid.Column="7" Content="{DynamicResource BtnTest}"
                            Click="BtnTestSsh_Click" x:Name="BtnTest"/>
                    <Button Grid.Column="8" x:Name="BtnConnect"
                            Click="BtnConnect_Click" BorderBrush="#7BE8C881"/>
                </Grid>
            </GroupBox>

            <!-- ── Workspace ────────────────────────────────────── -->
            <GroupBox Grid.Row="2" Header="{DynamicResource GbWorkspace}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="{DynamicResource LblFolder}"/>
                        <TextBox Grid.Column="1" x:Name="TbWorkspace"/>
                        <Button Grid.Column="2" Content="{DynamicResource BtnBrowse}"
                                Click="BtnBrowseWorkspace_Click"/>
                        <Button Grid.Column="3" Content="{DynamicResource BtnCreateStruct}"
                                Click="BtnCreateWorkspace_Click"/>
                        <Button Grid.Column="4" Content="{DynamicResource BtnOpen}"
                                Click="BtnOpenWorkspace_Click"/>
                    </Grid>
                    <TextBlock Margin="4,5,4,0" Foreground="#35E8C881" FontSize="10" TextWrapping="Wrap"
                               Text="{DynamicResource HintWorkspace}"/>
                </StackPanel>
            </GroupBox>

            <!-- ── Crea Patch ────────────────────────────────────── -->
            <GroupBox Grid.Row="3" Header="{DynamicResource GbPatch}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="{DynamicResource LblDesc}"/>
                        <TextBox Grid.Column="1" x:Name="TbPatchDesc"
                                 ToolTip="{DynamicResource TipPatchDesc}"/>
                        <Label Grid.Column="2" Content="{DynamicResource LblNum}"/>
                        <TextBox Grid.Column="3" x:Name="TbPatchNum" Text="auto"
                                 ToolTip="{DynamicResource TipPatchNum}"/>
                        <Button Grid.Column="5" x:Name="BtnBuild" Click="BtnBuild_Click"
                                Content="{DynamicResource BtnBuildStr}" FontWeight="SemiBold"
                                Background="#18E8C881" BorderBrush="#7BE8C881"/>
                        <Button Grid.Column="6" x:Name="BtnUpload" Click="BtnUpload_Click"
                                Content="{DynamicResource BtnUploadStr}" FontWeight="SemiBold"
                                Background="#18E8C881" BorderBrush="#7BE8C881"/>
                    </Grid>
                    <CheckBox x:Name="ChkDeleteLst" Margin="4,8,4,2"
                              Content="{DynamicResource ChkDeleteLstContent}"
                              Checked="ChkDeleteLst_Changed" Unchecked="ChkDeleteLst_Changed"/>
                    <Grid x:Name="PanelDeleteLst" Visibility="Collapsed" Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="72"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Foreground="#38E8C881" FontSize="10" Margin="4,0,4,3"
                                   Text="{DynamicResource HintDeleteLst}"/>
                        <TextBox Grid.Row="1" x:Name="TbDeleteLst" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="4,7,4,0">
                        <TextBlock Text="{DynamicResource LblLastPatch}" Foreground="#35E8C881"
                                   VerticalAlignment="Center" FontSize="10"/>
                        <TextBlock x:Name="TbLastPatch" Foreground="#7BE8C881"
                                   VerticalAlignment="Center" FontSize="11" FontFamily="Consolas"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="4,4,4,0">
                        <Button x:Name="BtnVerify" Content="{DynamicResource BtnVerifyStr}"
                                Click="BtnVerify_Click" ToolTip="{DynamicResource TipVerify}"/>
                        <Button x:Name="BtnExtract" Content="{DynamicResource BtnExtractStr}"
                                Click="BtnExtract_Click" ToolTip="{DynamicResource TipExtract}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- ── SAH Crypt ──────────────────────────────────── -->
            <GroupBox Grid.Row="4" Header="{DynamicResource GbSahCrypt}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="{DynamicResource LblSahFile}"/>
                        <TextBox Grid.Column="1" x:Name="TbSahFile"
                                 FontFamily="Consolas" FontSize="10"
                                 AllowDrop="True"
                                 Drop="TbSahFile_Drop"
                                 DragOver="TbSahFile_DragOver"
                                 ToolTip="{DynamicResource TipSahFile}"/>
                        <Button Grid.Column="2" Content="{DynamicResource BtnBrowse}"
                                Click="BtnSahBrowse_Click"/>
                        <Button Grid.Column="4" x:Name="BtnEncryptSah"
                                Content="{DynamicResource BtnEncryptSahStr}"
                                Click="BtnEncryptSah_Click"
                                ToolTip="{DynamicResource TipEncryptSah}"
                                FontWeight="SemiBold"
                                Background="#18E8C881" BorderBrush="#7BE8C881"/>
                        <Button Grid.Column="5" x:Name="BtnDecryptSah"
                                Content="{DynamicResource BtnDecryptSahStr}"
                                Click="BtnDecryptSah_Click"
                                ToolTip="{DynamicResource TipDecryptSah}"
                                FontWeight="SemiBold"
                                Background="#18E8C881" BorderBrush="#7BE8C881"/>
                    </Grid>
                    <TextBlock x:Name="TbSahCryptStatus" Margin="4,4,4,0"
                               FontSize="10" TextWrapping="Wrap"
                               Foreground="#50E8C881"/>
                </StackPanel>
            </GroupBox>

            <!-- ── Log ──────────────────────────────────────────── -->
            <GroupBox Grid.Row="5" Header="{DynamicResource GbLog}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" x:Name="TbLog"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11"
                             TextWrapping="NoWrap"
                             Background="#06060A" Foreground="#AADDE0E0"
                             BorderThickness="0" Padding="6,6">
                        <TextBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource GoldScrollBar}"/>
                        </TextBox.Resources>
                    </TextBox>
                    <Button Grid.Row="1" Content="{DynamicResource BtnClearLog}"
                            HorizontalAlignment="Right"
                            Click="BtnClearLog_Click" Margin="2,4,2,0"/>
                </Grid>
            </GroupBox>

        </Grid>
    </Border>
</Window>
