<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- GroupBox headers -->
    <sys:String x:Key="GbSsh">SSH CONNECTION</sys:String>
    <sys:String x:Key="GbWorkspace">WORKSPACE</sys:String>
    <sys:String x:Key="GbPatch">CREATE PATCH</sys:String>
    <sys:String x:Key="GbSettings">SETTINGS</sys:String>
    <sys:String x:Key="GbLog">LOG</sys:String>

    <!-- Labels -->
    <sys:String x:Key="LblHost">Host:</sys:String>
    <sys:String x:Key="LblUser">User:</sys:String>
    <sys:String x:Key="LblPass">Password:</sys:String>
    <sys:String x:Key="LblFolder">Folder:</sys:String>
    <sys:String x:Key="LblDesc">Description:</sys:String>
    <sys:String x:Key="LblNum">Number:</sys:String>
    <sys:String x:Key="LblPatchesPath">Patches Path:</sys:String>
    <sys:String x:Key="LblHtdocsPath">Htdocs Path:</sys:String>
    <sys:String x:Key="LblSahKey">SahKeyHex:</sys:String>
    <sys:String x:Key="LblLastPatch">Last patch: </sys:String>

    <!-- Buttons -->
    <sys:String x:Key="BtnTest">Test</sys:String>
    <sys:String x:Key="BtnConnectStr">Connect</sys:String>
    <sys:String x:Key="BtnBrowse">Browse...</sys:String>
    <sys:String x:Key="BtnCreateStruct">Create structure</sys:String>
    <sys:String x:Key="BtnOpen">Open</sys:String>
    <sys:String x:Key="BtnBuildStr">▶  Generate Patch</sys:String>
    <sys:String x:Key="BtnUploadStr">↑  Upload to Server</sys:String>
    <sys:String x:Key="BtnReadKey">Read from GMSecurity.ini...</sys:String>
    <sys:String x:Key="BtnSaveSettings">Save settings</sys:String>
    <sys:String x:Key="BtnClearLog">Clear log</sys:String>
    <sys:String x:Key="BtnVerifyStr">⊙  Verify .patch</sys:String>
    <sys:String x:Key="BtnExtractStr">↓  Extract .patch</sys:String>

    <!-- CheckBox -->
    <sys:String x:Key="ChkDeleteLstContent">Include delete.lst  (loose client files only — NOT files inside data.sah/saf)</sys:String>

    <!-- Hints -->
    <sys:String x:Key="HintWorkspace">Put files in workspace\data\ following the SAH structure  ·  Ex: data\Assets\General\Roulette.png  |  data\Item\Item.SData</sys:String>
    <sys:String x:Key="HintDeleteLst">Paths relative to the client folder, one per line.  Ex: filter.txt    Item\Item.SData    interface\sonovlogo.bmp</sys:String>

    <!-- Tooltips -->
    <sys:String x:Key="TipPatchDesc">Short text, e.g.: roulette_update. Used in the file name.</sys:String>
    <sys:String x:Key="TipPatchNum">auto = detect from SSH server. Or enter a fixed number e.g.: 4</sys:String>
    <sys:String x:Key="TipSahKey">AES-256 key from GMSecurity.ini (64 hex chars). If SSH is connected, reads from server automatically.</sys:String>
    <sys:String x:Key="TipReadKey">If SSH connected: reads from server (C:/ShaiyaServer/PSM_Client/Bin/Data/GMSecurity.ini). Otherwise: opens local file.</sys:String>
    <sys:String x:Key="TipPatchesPath">SFTP path where .patch files are uploaded on the server</sys:String>
    <sys:String x:Key="TipHtdocsPath">SFTP path of the web root (where manifest.json lives)</sys:String>
    <sys:String x:Key="TipVerify">Decrypts update.sah from the .patch and lists its files. Uses the last generated patch or opens a file picker.</sys:String>
    <sys:String x:Key="TipExtract">Extracts the .patch to a folder with the same name and decrypts update.sah → plain SAH. update.saf is extracted as-is.</sys:String>

    <!-- Settings window -->
    <sys:String x:Key="SettingsTitle">Settings</sys:String>
    <sys:String x:Key="GbSahKey">SAH KEY</sys:String>
    <sys:String x:Key="GbPatchKey">PATCH KEY (update.sah · auto-rotation 04:00)</sys:String>
    <sys:String x:Key="GbPaths">SERVER PATHS</sys:String>
    <sys:String x:Key="ChkEncryptContent">Encrypt update.sah (AES-256-GCM)</sys:String>
    <sys:String x:Key="ChkEncryptPatchContent">Encrypt patches (AES-256-GCM)</sys:String>
    <sys:String x:Key="TipPatchKey">AES-256 key (64 hex) for encrypting patches. Separate from SahKeyHex. Automatically rotated by the server at 04:00.</sys:String>
    <sys:String x:Key="TipReadPatchKey">Read PatchKeyHex from GMSecurity.ini (SSH server or local file)</sys:String>
    <sys:String x:Key="BtnCancel">Cancel</sys:String>

    <!-- SAH Crypt panel -->
    <sys:String x:Key="GbSahCrypt">SAH CRYPT</sys:String>
    <sys:String x:Key="LblSahFile">File .sah:</sys:String>
    <sys:String x:Key="BtnEncryptSahStr">🔒  Encrypt SAH</sys:String>
    <sys:String x:Key="BtnDecryptSahStr">🔓  Decrypt SAH</sys:String>
    <sys:String x:Key="TipSahFile">Path to the data.sah file to encrypt or decrypt. Drag &amp; drop or use Browse.</sys:String>
    <sys:String x:Key="TipEncryptSah">Encrypt data.sah (plain SAH → ESAH AES-256-GCM). Original file is saved as data.dec.sah (backup).</sys:String>
    <sys:String x:Key="TipDecryptSah">Decrypt data.sah (ESAH → plain SAH). Encrypted file is saved as data.enc.sah (backup).</sys:String>

    <!-- Header -->
    <sys:String x:Key="AppSubtitle">Shaiya Patch Tool</sys:String>

</ResourceDictionary>
