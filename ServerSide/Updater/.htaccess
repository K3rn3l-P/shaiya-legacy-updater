# Dedicated rules for the updater subtree.
# Production-safe defaults: runtime endpoints public, diagnostics/tooling local-only.

Options -Indexes
ServerSignature Off

<IfModule mod_authz_core.c>
    # Public runtime access (launcher.php, api/auth, manifest, patch/recovery payloads).
    Require all granted

    # Never expose server-side config files.
    <FilesMatch "^config(\.sample)?\.php$">
        Require all denied
    </FilesMatch>

    # Never expose INI files directly.
    <FilesMatch "\.ini$">
        Require all denied
    </FilesMatch>

    # Localhost only diagnostics in root.
    <FilesMatch "^test-(env|db|config)\.php$">
        Require local
    </FilesMatch>

    # Block hidden/private artifacts.
    <FilesMatch "^(\.git|\.env|composer\.(json|lock)|phpunit\.xml|\.htaccess)$">
        Require all denied
    </FilesMatch>
</IfModule>

# MIME helpers used by updater hosting.
AddType text/plain .patch
AddType application/json .json

# Minimal security headers.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>
