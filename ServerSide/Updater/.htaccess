Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTP → HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # manifest.json servito dinamicamente da manifest.php
    RewriteRule ^manifest\.json$ manifest.php [L]
</IfModule>

<IfModule mod_authz_core.c>
    Require all granted

    <FilesMatch "^config(\.sample)?\.php$">
        Require all denied
    </FilesMatch>

    <FilesMatch "\.ini$">
        Require all denied
    </FilesMatch>

    <FilesMatch "^test-(env|db|config)\.php$">
        Require local
    </FilesMatch>

    <FilesMatch "\.(bak|orig|swp|sql|log|sh|bat|cmd)$">
        Require all denied
    </FilesMatch>

    <FilesMatch "^(\.|composer\.(json|lock)|phpunit\.xml|README\.md)">
        Require all denied
    </FilesMatch>

    # Blocca accesso diretto ai file .cache della cache SHA256
    <FilesMatch "\.cache$">
        Require all denied
    </FilesMatch>
</IfModule>

AddType text/plain .patch
AddType application/json .json

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>
